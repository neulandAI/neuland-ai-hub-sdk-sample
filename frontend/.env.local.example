# Sample backend this UI calls (python or nodejs sample-app)
NEXT_PUBLIC_API_URL=http://localhost:9999

# Hub frontend that issues the service token
NEXT_PUBLIC_HUB_FRONTEND_URL=http://localhost:3001

# Numeric id of your registered Hub application
NEXT_PUBLIC_AI_APP_ID=<app-id>

# "local" = paste-a-token sign-in page; unset = embedded-in-Hub mode
NEXT_PUBLIC_MODE=local
