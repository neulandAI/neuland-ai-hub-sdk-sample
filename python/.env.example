# Hub backend URL — the API the SDK talks to
NLND_HUB_API_URL=<hub-backend-url>

# JWT verification settings
NLND_JWT_ISSUER=<jwt-issuer>
NLND_JWT_AUDIENCE=<frontend-url>

# RSA public key
NLND_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----<paste-public-key-here>-----END PUBLIC KEY-----"

# Clock skew tolerance for JWT
NLND_JWT_LEEWAY_SECONDS=60
