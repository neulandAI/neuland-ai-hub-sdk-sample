# Your Hub API URL — the API the SDK talks to
NLND_HUB_API_URL=https://api.your-domain.com

# Service-token verification. Issuer must equal your Hub's NLND_JWT_ISSUER
# (default hub.neuland.ai.com; ask your Hub administrator if unsure).
# Audience is the app_url registered for this sample application in the Hub.
NLND_JWT_ISSUER=hub.neuland.ai.com
NLND_JWT_AUDIENCE=http://localhost:9999

# The Hub's RSA public key. Not downloadable from the API — ask your Hub administrator.
NLND_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----<paste-public-key-here>-----END PUBLIC KEY-----"

# Clock skew tolerance for JWT
NLND_JWT_LEEWAY_SECONDS=60
