{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "hub.ai backend",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--host", "0.0.0.0",
                "--port", "9999"
            ],
            "cwd": "${workspaceFolder}/sample-app",
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ]
}
